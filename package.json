{
  "name": "dsh-split-sidebar",
  "version": "0.3.0",
  "description": "Split the conversation horizontally for independent terminal tabs, side-by-side files and seekable media previews.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-resources",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar-files",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-terminal-controller",
        "@deepseek-ai/dsh-client-ui-sidebar-terminal",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "media-ranges.js",
    "assets.js",
    "panel.js",
    "ghostty.js",
    "locale",
    "detail"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qso/dsh-split-sidebar.git"
  },
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.2-rc.5 <0.3.0-0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "desktop-plugin"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0"
  }
}
